SENTRYCODE_POSTGRES_PASSWORD=replace-with-strong-random-password
SENTRYCODE_UI_TOKEN=replace-with-viewer-access-token
SENTRYCODE_UI_ADMIN_TOKEN=replace-with-admin-token
SENTRYCODE_TENANT=standalone
SENTRYCODE_PROJECT=default
SENTRYCODE_BIND_ADDRESS=127.0.0.1
SENTRYCODE_PORT=7787
SENTRYCODE_IMAGE_TAG=0.1.0

# Optional enterprise OIDC. Roles are assigned in SentryCode's principal registry.
SENTRYCODE_OIDC_ISSUER=
SENTRYCODE_OIDC_AUDIENCE=
SENTRYCODE_OIDC_JWKS_URI=

# Optional Gerrit first-class review integration.
SENTRYCODE_GERRIT_URL=
SENTRYCODE_GERRIT_TOKEN=
SENTRYCODE_GERRIT_USERNAME=
SENTRYCODE_GERRIT_PASSWORD=
