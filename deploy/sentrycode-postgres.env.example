SENTRYCODE_POSTGRES_PASSWORD=replace-with-a-long-random-password
SENTRYCODE_POSTGRES_PORT=54327
# Consumed by the SentryCode process, not by PostgreSQL itself:
SENTRYCODE_DATABASE_URL=postgresql://sentrycode:replace-with-a-long-random-password@127.0.0.1:54327/sentrycode
SENTRYCODE_UI_ADMIN_TOKEN=replace-with-a-separate-long-random-admin-token
